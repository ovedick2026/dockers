FROM node:20-bookworm-slim

# 1. 安装基础依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*

# 2. 修复 xdg-open 报错（创建伪造脚本，防止 Web 模式弹出本地浏览器报错）
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open \
    && chmod +x /usr/local/bin/xdg-open

# 3. 构建阶段：直接下载 opencode 并解压到系统全局可执行目录 /usr/local/bin/
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64) ARCH=x64 ;; \
      aarch64) ARCH=arm64 ;; \
      *) echo "Unsupported arch: $ARCH"; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-${ARCH}.tar.gz" | tar -xz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/opencode

# 4. 预先创建配置与工作区目录，并将 /home/node 文件夹的所有权赋予 node 用户
RUN mkdir -p /home/node/workspace /home/node/.config /home/node/.local /home/node/.opencode \
    && chown -R node:node /home/node

ENV HOME=/home/node
ENV OPENCODE_SERVER_PASSWORD=111111

# 切换回低权限的 node 用户
USER node
WORKDIR /home/node/workspace

EXPOSE 7860

# 5. 直接启动服务
CMD ["opencode", "web", "--port", "7860", "--hostname", "0.0.0.0"]
