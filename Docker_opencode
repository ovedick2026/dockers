FROM node:20-bookworm-slim

# 1. 安装基础依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*

# 2. 修复 xdg-open 报错（创建伪造脚本，防止 Web 模式弹出本地浏览器报错）
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open \
    && chmod +x /usr/local/bin/xdg-open

# 3. 构建阶段：直接下载 opencode 并解压到系统全局可执行目录 /usr/local/bin/
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64) ARCH=x64 ;; \
      aarch64) ARCH=arm64 ;; \
      *) echo "Unsupported arch: $ARCH"; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-${ARCH}.tar.gz" | tar -xz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/opencode

# 4. 创建 Choreo 规范的 10099 用户/用户组，并预先创建所需目录
RUN groupadd --gid 10099 choreo && \
    useradd --uid 10099 --gid 10099 -m -d /home/choreo choreo && \
    mkdir -p /home/choreo/workspace /home/choreo/.config /home/choreo/.local /home/choreo/.opencode && \
    chown -R 10099:10099 /home/choreo

# 设置环境变量指向新的 HOME 路径
ENV HOME=/home/choreo
ENV OPENCODE_SERVER_PASSWORD=111111

# 5. 切换为 Choreo 强制要求的 10099 数字 UID 用户
USER 10099
WORKDIR /home/choreo/workspace

EXPOSE 7860

# 6. 启动 OpenCode 网页端服务
CMD ["opencode", "web", "--port", "7860", "--hostname", "0.0.0.0"]
