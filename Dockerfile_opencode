FROM node:20-bookworm-slim

# 1. 基础依赖：zip 用于多文件打包下载
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates curl tar zip \
    && rm -rf /var/lib/apt/lists/*

# 2. 避免 Web 模式调用本地浏览器时报 xdg-open 错误
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open \
    && chmod +x /usr/local/bin/xdg-open

# 3. 下载 OpenCode
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64) ARCH=x64 ;; \
      aarch64) ARCH=arm64 ;; \
      *) echo "Unsupported arch: $ARCH"; exit 1 ;; \
    esac && \
    curl -fsSL \
      "https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-${ARCH}.tar.gz" \
      | tar -xz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/opencode

# 4. 创建 Choreo 要求的用户和目录
RUN groupadd --gid 10099 choreo && \
    useradd --uid 10099 --gid 10099 -m -d /home/choreo choreo && \
    mkdir -p \
      /home/choreo/workspace \
      /home/choreo/.config \
      /home/choreo/.local \
      /home/choreo/.opencode \
      /opt/opencode-files && \
    chown -R 10099:10099 /home/choreo /opt/opencode-files

# 5. 放入 /files 网关程序
COPY --chown=10099:10099 server.mjs /opt/opencode-files/server.mjs

ENV HOME=/home/choreo

# OpenCode Web Basic Auth
# 请在 Choreo 控制台用 Secret 覆盖此值
ENV OPENCODE_SERVER_USERNAME=opencode
ENV OPENCODE_SERVER_PASSWORD=CHANGE_THIS_IN_CHOREO

# 文件浏览器根目录；只会暴露这里面的文件
ENV FILES_ROOT=/home/choreo/workspace

# 联网搜索工具开关：启用 Exa websearch
ENV OPENCODE_ENABLE_EXA=1

# 减少 OpenCode 的工具确认弹窗：
# edit 覆盖 write/edit/apply_patch；
# websearch + webfetch 允许联网搜索与抓取；
# external_directory 允许访问工作区外明确允许的路径。
ENV OPENCODE_PERMISSION='{"edit":"allow","websearch":"allow","webfetch":"allow","external_directory":"allow"}'

USER 10099
WORKDIR /home/choreo/workspace

EXPOSE 7860

# Node 网关对外监听 7860；
# 它会在容器内启动 opencode web 到 127.0.0.1:7861。
CMD ["node", "/opt/opencode-files/server.mjs"]
