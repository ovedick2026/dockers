FROM node:20-bookworm-slim

# 1. 安装基础依赖和 Python3
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates curl tar python3 \
    && rm -rf /var/lib/apt/lists/*

# 2. 修复 xdg-open 报错（防止 Web 模式弹出本地浏览器报错）
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open \
    && chmod +x /usr/local/bin/xdg-open

# 3. 下载 opencode 并解压到 /usr/local/bin/
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64) ARCH=x64 ;; \
      aarch64) ARCH=arm64 ;; \
      *) echo "Unsupported arch: $ARCH"; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-${ARCH}.tar.gz" | tar -xz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/opencode

# 4. 创建 Choreo 规范的 10099 用户/用户组，并预创建所需目录
RUN groupadd --gid 10099 choreo && \
    useradd --uid 10099 --gid 10099 -m -d /home/choreo choreo && \
    mkdir -p /home/choreo/workspace /home/choreo/.config/opencode /home/choreo/.local /home/choreo/.opencode && \
    chown -R 10099:10099 /home/choreo

# 5. 生成纯 Python 转发与文件浏览服务脚本 /usr/local/bin/server.py（无软链接，无权限依赖）
RUN echo 'import socket, select, threading, http.server, socketserver' > /usr/local/bin/server.py && \
    echo 'LISTEN_PORT = 7860' >> /usr/local/bin/server.py && \
    echo 'OPENCODE_PORT = 7861' >> /usr/local/bin/server.py && \
    echo 'FILE_PORT = 8080' >> /usr/local/bin/server.py && \
    echo 'WORKSPACE_DIR = "/home/choreo/workspace"' >> /usr/local/bin/server.py && \
    echo 'class CustomFileHandler(http.server.SimpleHTTPRequestHandler):' >> /usr/local/bin/server.py && \
    echo '    def translate_path(self, path):' >> /usr/local/bin/server.py && \
    echo '        if path.startswith("/files"):' >> /usr/local/bin/server.py && \
    echo '            path = path[6:]' >> /usr/local/bin/server.py && \
    echo '            if not path or not path.startswith("/"): path = "/" + path' >> /usr/local/bin/server.py && \
    echo '        return super().translate_path(path)' >> /usr/local/bin/server.py && \
    echo 'def start_file_server():' >> /usr/local/bin/server.py && \
    echo '    class DualStackServer(socketserver.TCPServer): allow_reuse_address = True' >> /usr/local/bin/server.py && \
    echo '    handler = lambda *args: CustomFileHandler(*args, directory=WORKSPACE_DIR)' >> /usr/local/bin/server.py && \
    echo '    with DualStackServer(("127.0.0.1", FILE_PORT), handler) as httpd:' >> /usr/local/bin/server.py && \
    echo '        httpd.serve_forever()' >> /usr/local/bin/server.py && \
    echo 'def pipe_socket(client_sock, target_port):' >> /usr/local/bin/server.py && \
    echo '    try:' >> /usr/local/bin/server.py && \
    echo '        target_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)' >> /usr/local/bin/server.py && \
    echo '        target_sock.connect(("127.0.0.1", target_port))' >> /usr/local/bin/server.py && \
    echo '        sockets = [client_sock, target_sock]' >> /usr/local/bin/server.py && \
    echo '        while True:' >> /usr/local/bin/server.py && \
    echo '            readable, _, _ = select.select(sockets, [], [], 120)' >> /usr/local/bin/server.py && \
    echo '            if not readable: break' >> /usr/local/bin/server.py && \
    echo '            for s in readable:' >> /usr/local/bin/server.py && \
    echo '                other = target_sock if s is client_sock else client_sock' >> /usr/local/bin/server.py && \
    echo '                data = s.recv(8192)' >> /usr/local/bin/server.py && \
    echo '                if not data: return' >> /usr/local/bin/server.py && \
    echo '                other.sendall(data)' >> /usr/local/bin/server.py && \
    echo '    except Exception: pass' >> /usr/local/bin/server.py && \
    echo '    finally:' >> /usr/local/bin/server.py && \
    echo '        try: client_sock.close()' >> /usr/local/bin/server.py && \
    echo '        except: pass' >> /usr/local/bin/server.py && \
    echo '        try: target_sock.close()' >> /usr/local/bin/server.py && \
    echo '        except: pass' >> /usr/local/bin/server.py && \
    echo 'def start_proxy():' >> /usr/local/bin/server.py && \
    echo '    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)' >> /usr/local/bin/server.py && \
    echo '    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)' >> /usr/local/bin/server.py && \
    echo '    server.bind(("0.0.0.0", LISTEN_PORT))' >> /usr/local/bin/server.py && \
    echo '    server.listen(128)' >> /usr/local/bin/server.py && \
    echo '    while True:' >> /usr/local/bin/server.py && \
    echo '        client_sock, _ = server.accept()' >> /usr/local/bin/server.py && \
    echo '        try:' >> /usr/local/bin/server.py && \
    echo '            peek_data = client_sock.recv(4096, socket.MSG_PEEK)' >> /usr/local/bin/server.py && \
    echo '            if not peek_data: client_sock.close(); continue' >> /usr/local/bin/server.py && \
    echo '            line = peek_data.decode("utf-8", errors="ignore").split("\r\n")[0]' >> /usr/local/bin/server.py && \
    echo '            target_port = FILE_PORT if "/files" in line else OPENCODE_PORT' >> /usr/local/bin/server.py && \
    echo '            t = threading.Thread(target=pipe_socket, args=(client_sock, target_port))' >> /usr/local/bin/server.py && \
    echo '            t.daemon = True' >> /usr/local/bin/server.py && \
    echo '            t.start()' >> /usr/local/bin/server.py && \
    echo '        except Exception: client_sock.close()' >> /usr/local/bin/server.py && \
    echo 'if __name__ == "__main__":' >> /usr/local/bin/server.py && \
    echo '    threading.Thread(target=start_file_server, daemon=True).start()' >> /usr/local/bin/server.py && \
    echo '    start_proxy()' >> /usr/local/bin/server.py

# 6. 生成入口启动脚本 /usr/local/bin/entrypoint.sh
RUN echo '#!/bin/sh' > /usr/local/bin/entrypoint.sh && \
    echo 'mkdir -p /home/choreo/workspace /home/choreo/.config/opencode' >> /usr/local/bin/entrypoint.sh && \
    echo 'echo "{\"permission\":\"allow\"}" > /home/choreo/.config/opencode/opencode.json' >> /usr/local/bin/entrypoint.sh && \
    echo 'cd /home/choreo/workspace && opencode web --port 7861 --hostname 127.0.0.1 &' >> /usr/local/bin/entrypoint.sh && \
    echo 'exec python3 /usr/local/bin/server.py' >> /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

# 设置环境变量
ENV HOME=/home/choreo
ENV OPENCODE_SERVER_PASSWORD=111111
ENV OPENCODE_PERMISSION='{"*":"allow"}'

# 7. 切换为 10099 用户
USER 10099
WORKDIR /home/choreo/workspace

# 暴露端口 7860
EXPOSE 7860

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
