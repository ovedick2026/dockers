FROM node:20-bookworm-slim

# 1. 安装基础依赖和轻量版 Nginx
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates curl tar nginx-light \
    && rm -rf /var/lib/apt/lists/*

# 2. 修复 xdg-open 报错
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open \
    && chmod +x /usr/local/bin/xdg-open

# 3. 安装 opencode 和 filebrowser 到系统目录 /usr/local/bin/
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64) OPENCODE_ARCH=x64; FB_ARCH=amd64 ;; \
      aarch64) OPENCODE_ARCH=arm64; FB_ARCH=arm64 ;; \
      *) echo "Unsupported arch: $ARCH"; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-${OPENCODE_ARCH}.tar.gz" | tar -xz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/opencode && \
    curl -fsSL "https://github.com/filebrowser/filebrowser/releases/latest/download/linux-${FB_ARCH}-filebrowser.tar.gz" | tar -xz -C /usr/local/bin/ filebrowser && \
    chmod +x /usr/local/bin/filebrowser

# 4. 创建 Choreo 规范的 10099 用户
RUN groupadd --gid 10099 choreo && \
    useradd --uid 10099 --gid 10099 -m -d /home/choreo choreo

# 5. 生成系统级 Nginx 配置文件
RUN echo 'pid /tmp/nginx.pid;' > /etc/nginx/custom_nginx.conf && \
    echo 'events { worker_connections 1024; }' >> /etc/nginx/custom_nginx.conf && \
    echo 'http {' >> /etc/nginx/custom_nginx.conf && \
    echo '    include /etc/nginx/mime.types;' >> /etc/nginx/custom_nginx.conf && \
    echo '    default_type application/octet-stream;' >> /etc/nginx/custom_nginx.conf && \
    echo '    client_body_temp_path /tmp/nginx_client_body;' >> /etc/nginx/custom_nginx.conf && \
    echo '    proxy_temp_path /tmp/nginx_proxy;' >> /etc/nginx/custom_nginx.conf && \
    echo '    fastcgi_temp_path /tmp/nginx_fastcgi;' >> /etc/nginx/custom_nginx.conf && \
    echo '    uwsgi_temp_path /tmp/nginx_uwsgi;' >> /etc/nginx/custom_nginx.conf && \
    echo '    scgi_temp_path /tmp/nginx_scgi;' >> /etc/nginx/custom_nginx.conf && \
    echo '    access_log /tmp/nginx_access.log;' >> /etc/nginx/custom_nginx.conf && \
    echo '    error_log /tmp/nginx_error.log;' >> /etc/nginx/custom_nginx.conf && \
    echo '    server {' >> /etc/nginx/custom_nginx.conf && \
    echo '        listen 7860;' >> /etc/nginx/custom_nginx.conf && \
    echo '        location /files/ {' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_pass http://127.0.0.1:8080;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header Host $host;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header X-Real-IP $remote_addr;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header X-Forwarded-Proto $scheme;' >> /etc/nginx/custom_nginx.conf && \
    echo '        }' >> /etc/nginx/custom_nginx.conf && \
    echo '        location / {' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_pass http://127.0.0.1:7861;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_http_version 1.1;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header Upgrade $http_upgrade;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header Connection "upgrade";' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header Host $host;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header X-Real-IP $remote_addr;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' >> /etc/nginx/custom_nginx.conf && \
    echo '            proxy_set_header X-Forwarded-Proto $scheme;' >> /etc/nginx/custom_nginx.conf && \
    echo '        }' >> /etc/nginx/custom_nginx.conf && \
    echo '    }' >> /etc/nginx/custom_nginx.conf && \
    echo '}' >> /etc/nginx/custom_nginx.conf

# 6. 生成安全的系统级入口脚本（在可写的 /tmp 下建工作区和配置文件）
RUN printf '#!/bin/sh\n\
mkdir -p /tmp/workspace /tmp/.config/opencode /tmp/.local /tmp/.opencode\n\
printf "{\"permission\":\"allow\"}" > /tmp/.config/opencode/opencode.json\n\
filebrowser --port 8080 --address 127.0.0.1 --baseurl /files --root /tmp/workspace --database /tmp/filebrowser.db --noauth &\n\
cd /tmp/workspace && opencode web --port 7861 --hostname 127.0.0.1 &\n\
exec nginx -c /etc/nginx/custom_nginx.conf -g "daemon off;"\n' > /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh

# 设置 HOME 为 /tmp，确保 OpenCode 读写配置正常
ENV HOME=/tmp
ENV OPENCODE_SERVER_PASSWORD=111111
ENV OPENCODE_PERMISSION='{"*":"allow"}'

# 切换为 10099 非 root 用户
USER 10099
WORKDIR /tmp/workspace

# 暴露端口
EXPOSE 7860

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
